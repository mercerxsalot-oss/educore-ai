PORT=3000
# Optional: protects your API quota. Users enter it once per browser session.
ACCESS_CODE=
# AI (Anthropic)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
# Search: brave | google
SEARCH_PROVIDER=brave
BRAVE_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CX=
SEARCH_COUNT=5
CACHE_TTL_MIN=60
RATE_LIMIT=40
# Optional speech-to-text fallback for browsers without Web Speech (e.g. Firefox)
OPENAI_API_KEY=
# Allow index.html hosted on another domain (comma-separated origins)
ALLOWED_ORIGIN=
